# Copie para .env.local (desenvolvimento) ou deixe a Vercel criar (produção).
# Sem a URL do banco o app funciona normalmente, só que guardando os dados
# apenas no aparelho de quem está usando.

# Criada sozinha pela integração Neon da Vercel. Só a função api/loreta.ts usa;
# nunca vai pro navegador.
# bancoloreta_DATABASE_URL=postgres://usuario:senha@host/neondb?sslmode=require

# Opcional: com esta variável o site pede a senha da casa pra entrar.
# LORETA_SENHA_DA_CASA=
